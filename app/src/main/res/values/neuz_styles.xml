<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NeuzTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/neuz_bg_primary</item>
        <item name="android:statusBarColor">@color/neuz_bg_primary</item>
        <item name="android:navigationBarColor">@color/neuz_bg_primary</item>
        <item name="android:windowBackground">@color/neuz_bg_primary</item>
    </style>

    <style name="NeuzHeader">
        <item name="android:background">@color/neuz_bg_secondary</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="NeuzToolbar">
        <item name="android:background">@color/neuz_bg_surface</item>
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="NeuzButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/neuz_button_text</item>
        <item name="android:background">@color/neuz_button_normal</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
    </style>

    <style name="NeuzButton.ToolAdd" parent="NeuzButton">
        <item name="android:background">@color/neuz_tool_add</item>
    </style>

    <style name="NeuzButton.ToolDelete" parent="NeuzButton">
        <item name="android:background">@color/neuz_tool_delete</item>
    </style>

    <style name="NeuzButton.ToolAnimate" parent="NeuzButton">
        <item name="android:background">@color/neuz_tool_animate</item>
    </style>

    <style name="NeuzStatusText">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/neuz_text_secondary</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="NeuzLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/neuz_text_primary</item>
    </style>

    <style name="NeuzPanel">
        <item name="android:background">@color/neuz_bg_secondary</item>
        <item name="android:padding">8dp</item>
    </style>
</resources>
